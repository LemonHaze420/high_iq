	{0x2f, 0x05, 0x00},
	{0x30, 0x06, 0x00},
	{0xfe, 0x01, 0x00},
}

anim_g1_b0 := [?]Anim_Entry{
	{0x00, 0x0a, 0x00},
	{0x00, 0x0a, 0x00},
	{0x00, 0x0a, 0x00},
	{0x00, 0x0a, 0x00},
	{0xfe, 0x01, 0x00},
}

anim_g1_b1 := [?]Anim_Entry{
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x01, 0x00},
	{0x00, 0x02, 0x00},
	{0x00, 0x02, 0x00},
	{0x00, 0x02, 0x00},
	{0x00, 0x02, 0x00},
	{0x00, 0x03, 0x00},
	{0x00, 0x03, 0x00},
	{0x00, 0x03, 0x00},
	{0x00, 0x03, 0x00},
	{0x00, 0x04, 0x00},
	{0x00, 0x04, 0x00},
	{0xfe, 0x01, 0x00},
}

player_animation_sequence :: proc(character, behavior: i32) -> []Anim_Entry {
	group := clamp(character, 0, 2)
	selected := behavior
	if selected == 6 { selected = 2 }
	if selected == 7 { selected = 3 }
	switch group {
	case 0:
		switch selected {
		case 0: return anim_g0_b0[:]
		case 1: return anim_g0_b1[:]
		case 2: return anim_g0_b2[:]
		case 3: return anim_g0_b3[:]
		case 4: return anim_g0_b4[:]
		case 5: return anim_g0_b5[:]
		case 8: return anim_g0_b8[:]
		case 9: return anim_g0_b9[:]
		case 10: return anim_g0_b10[:]
		case: return anim_g0_b0[:]
		}
	case 1:
		switch selected {
		case 0: return anim_g1_b0[:]
		case 1: return anim_g1_b1[:]
		case 2: return anim_g1_b2[:]
		case 3: return anim_g1_b3[:]
		case 4: return anim_g1_b4[:]
		case 5: return anim_g1_b5[:]
		case 8: return anim_g1_b8[:]
		case 9: return anim_g1_b9[:]
		case 10: return anim_g1_b10[:]
		case: return anim_g1_b0[:]
		}
	case 2:
		switch selected {
		case 0: return anim_g2_b0[:]
		case 1: return anim_g2_b1[:]
		case 2: return anim_g2_b2[:]
		case 3: return anim_g2_b3[:]
		case 4: return anim_g2_b4[:]
		case 5: return anim_g2_b5[:]
		case 8: return anim_g2_b8[:]
		case 9: return anim_g2_b9[:]
		case 10: return anim_g2_b10[:]
		case: return anim_g2_b0[:]
		}
	case: return anim_g0_b0[:]
	}
}
